<?xml version="1.0" encoding="utf-8"?>
<com.kongzue.dialogx.util.views.DialogXBaseRelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:theme="@style/DialogXMd3Theme"
    android:orientation="vertical"
    android:id="@+id/box_root"
    android:background="@color/dialogBkg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:autoSafeArea="false"
    app:baseFocusable="true">
    <com.kongzue.dialogx.util.views.MaxRelativeLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/box_body"
        android:background="@drawable/rect_dialogx_md3_popmenu_bkg"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:elevation="3dp">
        <RelativeLayout
            android:id="@+id/box_custom"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
        <com.kongzue.dialogx.util.views.PopMenuListView
            android:id="@+id/listMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/box_custom"/>
    </com.kongzue.dialogx.util.views.MaxRelativeLayout>
</com.kongzue.dialogx.util.views.DialogXBaseRelativeLayout>
