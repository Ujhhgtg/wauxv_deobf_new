<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="?attr/dialogPreferredPadding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="?attr/dialogPreferredPadding"
        android:paddingEnd="?attr/dialogPreferredPadding">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="菜单名称">
            <com.google.android.material.textfield.TextInputEditText
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/moduleDialogEdtFabMenuTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="图标文件名">
            <com.google.android.material.textfield.TextInputEditText
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/moduleDialogEdtFabMenuIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="图标文件放在 Resource/Fab，填文件名即可；不存在时会使用默认图标。"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="类型">
            <com.google.android.material.textfield.TextInputEditText
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/moduleDialogEdtFabMenuType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="支持 activity / wauxv。"/>
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="动作值">
            <com.google.android.material.textfield.TextInputEditText
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/moduleDialogEdtFabMenuAction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"/>
        </com.google.android.material.textfield.TextInputLayout>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="activity 填完整类名；wauxv 可填 openSetting、clearUnreadCount、killProcess。"/>
        <com.google.android.material.checkbox.MaterialCheckBox
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/moduleDialogCbFabMenuEnable"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="启用此菜单项"/>
    </LinearLayout>
</ScrollView>
